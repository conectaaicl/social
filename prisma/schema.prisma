generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId      String?

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenant ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  plan        PlanType @default(BASIC)
  aiProvider      String   @default("auto")
  openaiApiKey    String?
  anthropicApiKey String?
  groqApiKey      String?
  active      Boolean  @default(true)
  domain      String?
  notes       String?
  whatsappPhone    String?
  whatsappInstance String?
  whatsappApiUrl   String?
  whatsappApiKey   String?
  metaAppId        String?
  metaAppSecret    String?
  falApiKey        String?
  replicateApiToken String?
  stabilityApiKey  String?
  googleAdsClientId      String?
  googleAdsClientSecret  String?
  googleAdsRefreshToken  String?
  googleAdsDeveloperToken String?
  googleAdsCustomerId    String?
  ayrshareApiKey           String?
  pinterestAppId           String?
  pinterestAppSecret       String?
  googleBusinessClientId   String?
  googleBusinessClientSecret String?
  cloudflareAccountId      String?
  cloudflareR2AccessKey    String?
  cloudflareR2SecretKey    String?
  cloudflareR2Bucket       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  socialAccounts  SocialAccount[]
  brandVoice      BrandVoice?
  posts           Post[]
  mediaLibrary    MediaItem[]
  calendar        CalendarConfig?
  postComments    PostComment[]
  adCampaigns     AdCampaign[]
  mediaCategories MediaCategory[]
  affiliates       Affiliate[]
  calendarSlots   CalendarSlot[]
  socialLeads     SocialLead[]
  winningPatterns WinningPattern[]
  competitors     Competitor[]
  videoScripts    VideoScript[]
  abTests         ABTest[]

  @@map("tenants")
}

// ─── Social Accounts ────────────────────────────────────

model SocialAccount {
  id                String        @id @default(cuid())
  platform          Platform
  accountId         String
  accountName       String
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  pageId            String?       // Facebook Page ID
  openId            String?       // TikTok open_id
  dailyPostCount    Int           @default(0)
  dailyPostResetAt  DateTime?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  tenantId          String

  posts             Post[]

  @@unique([tenantId, platform, accountId])
  @@map("social_accounts")
}

// ─── Brand Voice ────────────────────────────────────────

model BrandVoice {
  id            String   @id @default(cuid())
  industry      String
  description   String
  tone          String   // cercano, elegante, técnico, divertido...
  keywords      String[] // palabras clave del negocio
  products      String[] // productos/servicios principales
  targetAudience String
  language      String   @default("es-CL")
  customPrompt  String?  // prompt adicional personalizado
  brandColors   String[] @default([])  // colores hex del branding
  competitorHandles String[] @default([])  // handles de competidores a monitorear
  autoReply     Boolean  @default(false)
  autoReplyTone String?  // profesional, amigable, entusiasta
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String   @unique

  @@map("brand_voices")
}

// ─── Calendar Config ────────────────────────────────────

model CalendarConfig {
  id              String   @id @default(cuid())
  postsPerDay     Int      @default(3)
  scheduleSlots   Json     // [{time: "09:00", type: "feed"}, {time: "13:00", type: "story"}, ...]
  contentMix      Json     // {producto: 30, tip: 25, proyecto: 25, promo: 20}
  autoPublish     Boolean  @default(true)
  autoReplyComments Boolean @default(false)
  timezone        String   @default("America/Santiago")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String   @unique

  @@map("calendar_configs")
}

// ─── Posts ──────────────────────────────────────────────

model Post {
  id              String      @id @default(cuid())
  type            PostType
  contentType     ContentType
  platform        Platform[]
  status          PostStatus  @default(PENDING)

  caption         String
  hashtags        String
  imagePrompt     String?
  videoPrompt     String?

  mediaUrls       String[]
  thumbnailUrl    String?

  scheduledAt     DateTime
  publishedAt     DateTime?
  failedAt        DateTime?
  failReason      String?

  metaPostId      String?     // ID retornado por Meta al publicar
  approvalToken   String?     // token único para correlacionar aprobación WA
  approvalSentAt  DateTime?   // cuándo se envió el mensaje de aprobación
  reach           Int?
  likes           Int?
  comments        Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  tenantId        String

  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  socialAccountId String?

  postComments    PostComment[]
  adCampaigns     AdCampaign[]
  calendarSlot    CalendarSlot?

  @@map("posts")
}

// ─── Comments ───────────────────────────────────────────

model PostComment {
  id              String    @id @default(cuid())
  metaCommentId   String    @unique
  username        String
  text            String
  sentiment       String?   // positive, neutral, negative
  replied         Boolean   @default(false)
  replyText       String?
  repliedAt       DateTime?
  createdAt       DateTime  @default(now())

  post            Post      @relation(fields: [postId], references: [id])
  postId          String

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  tenantId        String

  @@map("post_comments")
}

// ─── Media Library ──────────────────────────────────────

model MediaItem {
  id          String      @id @default(cuid())
  url         String
  type        MediaType
  source      MediaSource
  prompt      String?
  width       Int?
  height      Int?
  duration    Int?        // segundos, para videos
  tags        String[]
  categoryId  String?
  category    MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String

  @@map("media_items")
}

// ─── Google Ads Campaigns ───────────────────────────────

model AdCampaign {
  id              String         @id @default(cuid())
  name            String
  status          AdStatus       @default(DRAFT)
  objective       String         // AWARENESS, TRAFFIC, CONVERSIONS
  budget          Float          // diario en CLP
  startDate       DateTime
  endDate         DateTime?
  targetUrl       String
  headlines       String[]       // hasta 15 titulos (max 30 chars c/u)
  descriptions    String[]       // hasta 4 descripciones (max 90 chars c/u)
  keywords        String[]
  googleCampaignId String?       // ID asignado por Google Ads API
  googleAdGroupId  String?
  googleAdId       String?
  impressions     Int?
  clicks          Int?
  spend           Float?         // gasto real en CLP
  conversions     Int?

  post            Post?          @relation(fields: [postId], references: [id])
  postId          String?

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  tenantId        String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("ad_campaigns")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  SUPERADMIN
  OWNER
  EDITOR
}

enum PlanType {
  BASIC
  PRO
  AGENCY
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  TWITTER
  YOUTUBE
  PINTEREST
  THREADS
  GOOGLE_BUSINESS
}

enum PostType {
  FEED
  STORY
  CAROUSEL
  REEL
}

enum ContentType {
  PRODUCTO
  PROYECTO
  TIP
  PROMO
}

enum PostStatus {
  PENDING_APPROVAL
  PENDING
  GENERATING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaSource {
  AI_GENERATED
  UPLOADED
  STOCK
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

model MediaCategory {
  id         String      @id @default(cuid())
  name       String
  slug       String
  color      String      @default("#6366f1")
  icon       String      @default("📁")
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mediaItems MediaItem[]
  createdAt  DateTime    @default(now())

  @@unique([slug, tenantId])
  @@map("media_categories")
}


// ── Affiliate System ──────────────────────────────────────────────────────────

enum AffiliateType {
  REFERRAL
  RESELLER
  INFLUENCER
}

enum AffiliateStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  APPROVED
  PAID
  REJECTED
}

model Affiliate {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  email       String
  phone       String?
  type        AffiliateType   @default(REFERRAL)
  status      AffiliateStatus @default(ACTIVE)
  commission  Float           @default(10)
  notes       String?
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals   AffiliateReferral[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("affiliates")
}

model AffiliateReferral {
  id            String         @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tenantId      String
  referredName  String?
  referredEmail String?
  referredPhone String?
  amount        Float          @default(0)
  commission    Float          @default(0)
  notes         String?
  status        ReferralStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  @@map("affiliate_referrals")
}

model CalendarSlot {
  id           String   @id @default(cuid())
  tenantId     String
  year         Int
  month        Int
  scheduledDate DateTime
  timeSlot     String   @default("09:00")
  formato      String
  objetivo     String   @default("engagement")
  temaSugerido String?
  postId       String?  @unique
  post         Post?    @relation(fields: [postId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([tenantId, year, month])
  @@map("calendar_slots")
}

model SocialLead {
  id            String         @id @default(cuid())
  tenantId      String
  nombre        String?
  whatsappPhone String
  stage         String         @default("nuevo")
  leadScore     Int            @default(0)
  fuentePostId  String?
  lastActivity  DateTime?
  email         String?
  tags          String[]
  closerName    String?
  dealValue     Float?
  scoreReason   String?
  notes         LeadNote[]
  activities    LeadActivity[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([tenantId])
  @@map("social_leads")
}

model LeadActivity {
  id        String     @id @default(cuid())
  leadId    String
  tipo      String
  detalle   String?
  lead      SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  @@map("lead_activities")
}

model LeadNote {
  id        String     @id @default(cuid())
  leadId    String
  body      String
  lead      SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  @@map("lead_notes")
}

model WinningPattern {
  id              String   @id @default(cuid())
  tenantId        String
  descripcion     String
  avgEngagement   Float
  sampleSize      Int
  confidenceScore Float    @default(0.8)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@map("winning_patterns")
}

// === RADAR DE COMPETENCIA ===
model Competitor {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  handle         String
  platform       String           @default("instagram")
  tier           Int              @default(2)
  active         Boolean          @default(true)
  avatarUrl      String?
  followersCount Int?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          CompetitorPost[]

  @@unique([tenantId, handle])
  @@index([tenantId])
  @@map("competitors")
}

model CompetitorPost {
  id                String     @id @default(cuid())
  competitorId      String
  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  postId            String
  caption           String?
  mediaUrl          String?
  mediaType         String?
  likesCount        Int        @default(0)
  commentsCount     Int        @default(0)
  viewsCount        Int        @default(0)
  isViral           Boolean    @default(false)
  viralScore        Float      @default(0)
  postUrl           String?
  postedAt          DateTime?
  fetchedAt         DateTime   @default(now())
  recreated         Boolean    @default(false)
  recreatedCaption  String?
  recreatedImageUrl String?
  recreatedAt       DateTime?
  publishedAt       DateTime?

  @@unique([competitorId, postId])
  @@index([competitorId])
  @@index([isViral])
  @@index([postedAt])
  @@map("competitor_posts")
}

// === SEMANA 4: VIDEO GENERATOR + A/B TESTING ===

model VideoScript {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template     String   // tips | antes_despues | showcase | problema_solucion
  topic        String
  script       Json?
  status       String   @default("pending") // pending | processing | done | error
  outputUrl    String?
  thumbnailUrl String?
  duration     Int?
  postRef      String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("video_scripts")
}

model ABTest {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  hypothesis  String?
  postARef    String
  postBRef    String?
  status      String    @default("draft") // draft | running | completed
  winnerId    String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("ab_tests")
}
