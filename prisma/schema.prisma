generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId      String?

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenant ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  plan        PlanType @default(BASIC)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  socialAccounts  SocialAccount[]
  brandVoice      BrandVoice?
  posts           Post[]
  mediaLibrary    MediaItem[]
  mediaCategories MediaCategory[]
  calendar        CalendarConfig?
  postComments    PostComment[]
  adCampaigns     AdCampaign[]
  calendarSlots   CalendarSlot[]
  competitors     Competitor[]
  hashtagMonitors HashtagMonitor[]
  socialLeads     SocialLead[]
  affiliates      Affiliate[]
  bioPage         BioPage?
  aBTests         ABTest[]
  winningPatterns WinningPattern[]
  transcriptInsights TranscriptInsight[]
  postApprovals   PostApproval[]
  videoScripts    VideoScript[]

  // AI provider keys (per-tenant overrides)
  anthropicApiKey String?
  openaiApiKey    String?
  groqApiKey      String?
  aiProvider      String? @default("anthropic")
  apifyToken      String?
  flowApiKey      String?
  flowSecretKey   String?

  // Image/video generation APIs
  falApiKey           String?
  replicateApiToken   String?
  stabilityApiKey     String?

  // Meta integration
  metaAppId           String?
  metaAppSecret       String?

  // WhatsApp integration
  whatsappPhone       String?
  whatsappInstance    String?
  whatsappApiUrl      String?
  whatsappApiKey      String?

  // Google Ads integration
  googleAdsClientId       String?
  googleAdsClientSecret   String?
  googleAdsRefreshToken   String?
  googleAdsDeveloperToken String?
  googleAdsCustomerId     String?

  // Other integrations
  ayrshareApiKey          String?
  pinterestAppId          String?
  pinterestAppSecret      String?
  googleBusinessClientId  String?
  googleBusinessClientSecret String?

  // Cloudflare R2 storage
  cloudflareAccountId     String?
  cloudflareR2AccessKey   String?
  cloudflareR2SecretKey   String?
  cloudflareR2Bucket      String?

  // Billing (Flow)
  subscriptionOrderId    String?
  subscriptionExpiresAt  DateTime?

  // Agency / misc
  notes     String?
  domain    String?
  agencyId  String?
  agency    Tenant?  @relation("AgencyClients", fields: [agencyId], references: [id])
  clients   Tenant[] @relation("AgencyClients")

  @@map("tenants")
}

// ─── Social Accounts ────────────────────────────────────

model SocialAccount {
  id                String        @id @default(cuid())
  platform          Platform
  accountId         String
  accountName       String
  accessToken       String
  refreshToken      String?
  openId            String?
  tokenExpiresAt    DateTime?
  pageId            String?       // Facebook Page ID
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  tenantId          String

  posts             Post[]

  @@unique([tenantId, platform, accountId])
  @@map("social_accounts")
}

// ─── Brand Voice ────────────────────────────────────────

model BrandVoice {
  id            String   @id @default(cuid())
  industry      String
  description   String
  tone          String   // cercano, elegante, técnico, divertido...
  keywords      String[] // palabras clave del negocio
  products      String[] // productos/servicios principales
  targetAudience String
  language      String   @default("es-CL")
  customPrompt  String?  // prompt adicional personalizado
  brandColors   String[] @default([])  // colores hex del branding
  competitorHandles String[] @default([])  // handles de competidores a monitorear
  autoReply     Boolean  @default(false)
  autoReplyTone String?  // profesional, amigable, entusiasta
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String   @unique

  @@map("brand_voices")
}

// ─── Calendar Config ────────────────────────────────────

model CalendarConfig {
  id              String   @id @default(cuid())
  postsPerDay     Int      @default(3)
  scheduleSlots   Json     // [{time: "09:00", type: "feed"}, {time: "13:00", type: "story"}, ...]
  contentMix      Json     // {producto: 30, tip: 25, proyecto: 25, promo: 20}
  autoPublish     Boolean  @default(true)
  autoReplyComments Boolean @default(false)
  timezone        String   @default("America/Santiago")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String   @unique

  @@map("calendar_configs")
}

// ─── Posts ──────────────────────────────────────────────

model Post {
  id              String      @id @default(cuid())
  type            PostType
  contentType     ContentType
  platform        Platform[]
  status          PostStatus  @default(PENDING)

  caption         String
  hashtags        String
  imagePrompt     String?
  videoPrompt     String?

  mediaUrls       String[]
  thumbnailUrl    String?

  scheduledAt     DateTime
  publishedAt     DateTime?
  failedAt        DateTime?
  failReason      String?
  attempts        Int         @default(0)
  nextAttemptAt   DateTime?

  metaPostId      String?     // ID retornado por Meta al publicar
  reach           Int?
  likes           Int?
  comments        Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  tenantId        String

  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  socialAccountId String?

  postComments    PostComment[]
  adCampaigns     AdCampaign[]
  calendarSlots   CalendarSlot[]
  postApprovals   PostApproval[]
  approvalToken   String?
  approvalSentAt  DateTime?

  @@map("posts")
}

// ─── Comments ───────────────────────────────────────────

model PostComment {
  id              String    @id @default(cuid())
  metaCommentId   String    @unique
  username        String
  text            String
  sentiment       String?   // positive, neutral, negative
  replied         Boolean   @default(false)
  replyText       String?
  repliedAt       DateTime?
  createdAt       DateTime  @default(now())

  post            Post      @relation(fields: [postId], references: [id])
  postId          String

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  tenantId        String

  @@map("post_comments")
}

// ─── Media Library ──────────────────────────────────────

model MediaItem {
  id          String      @id @default(cuid())
  url         String
  type        MediaType
  source      MediaSource
  prompt      String?
  width       Int?
  height      Int?
  duration    Int?        // segundos, para videos
  tags        String[]
  categoryId  String?
  createdAt   DateTime    @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  tenantId    String
  category    MediaCategory? @relation(fields: [categoryId], references: [id])

  @@map("media_items")
}

model MediaCategory {
  id        String      @id
  tenantId  String
  name      String
  slug      String
  color     String      @default("#6366f1")
  icon      String      @default("📁")
  createdAt DateTime    @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  mediaItems MediaItem[]

  @@unique([tenantId, slug])
  @@map("media_categories")
}

// ─── Google Ads Campaigns ───────────────────────────────

model AdCampaign {
  id              String         @id @default(cuid())
  name            String
  status          AdStatus       @default(DRAFT)
  objective       String         // AWARENESS, TRAFFIC, CONVERSIONS
  budget          Float          // diario en CLP
  startDate       DateTime
  endDate         DateTime?
  targetUrl       String
  headlines       String[]       // hasta 15 titulos (max 30 chars c/u)
  descriptions    String[]       // hasta 4 descripciones (max 90 chars c/u)
  keywords        String[]
  googleCampaignId String?       // ID asignado por Google Ads API
  googleAdGroupId  String?
  googleAdId       String?
  impressions     Int?
  clicks          Int?
  spend           Float?         // gasto real en CLP
  conversions     Int?

  post            Post?          @relation(fields: [postId], references: [id])
  postId          String?

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  tenantId        String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("ad_campaigns")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  SUPERADMIN
  OWNER
  EDITOR
}

enum PlanType {
  BASIC
  PRO
  AGENCY
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
  PINTEREST
  LINKEDIN
  THREADS
  GOOGLE_BUSINESS
}

enum PostType {
  FEED
  STORY
  CAROUSEL
  REEL
}

enum ContentType {
  PRODUCTO
  PROYECTO
  TIP
  PROMO
}

enum PostStatus {
  PENDING
  PENDING_APPROVAL
  GENERATING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaSource {
  AI_GENERATED
  UPLOADED
  STOCK
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

// ─── Calendar Slots ─────────────────────────────────────

model CalendarSlot {
  id            String    @id @default(cuid())
  tenantId      String
  year          Int
  month         Int
  scheduledDate DateTime
  timeSlot      String
  formato       String
  objetivo      String
  temaSugerido  String?
  postId        String?

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  post          Post?     @relation(fields: [postId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("calendar_slots")
}

// ─── Radar / Competitors ─────────────────────────────────

model Competitor {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  handle         String
  platform       String    @default("instagram")
  tier           Int       @default(2)
  notes          String?
  active         Boolean   @default(true)
  followersCount Int?
  avatarUrl      String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  posts          CompetitorPost[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, handle], name: "tenantId_handle")
  @@map("competitors")
}

model CompetitorPost {
  id               String    @id @default(cuid())
  competitorId     String
  postId           String?
  mediaUrl         String?
  mediaType        String?
  postUrl          String?
  caption          String?
  postType         String?
  likesCount       Int?
  commentsCount    Int?
  viewsCount       Int?
  isViral          Boolean   @default(false)
  viralScore       Float?
  engagementRate   Float?
  recreated        Boolean   @default(false)
  recreatedCaption String?
  recreatedAt      DateTime?
  postedAt         DateTime?

  competitor       Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())

  @@unique([competitorId, postId], name: "competitorId_postId")
  @@map("competitor_posts")
}

// ─── Hashtag Monitor ────────────────────────────────────

model HashtagMonitor {
  id        String    @id @default(cuid())
  tenantId  String
  hashtag    String
  lastScan   DateTime?
  postsFound Int       @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  leads     HashtagLead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, hashtag])
  @@map("hashtag_monitors")
}

model HashtagLead {
  id             String   @id @default(cuid())
  monitorId      String
  tenantId       String
  postId         String?
  username       String
  caption        String?
  mediaUrl       String?
  followersCount Int?
  bio            String?
  likesCount     Int?
  commentsCount  Int?
  sentiment      String?
  sentimentScore Float?
  postUrl        String?
  contacted      Boolean  @default(false)
  contactedAt    DateTime?

  monitor        HashtagMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  scannedAt      DateTime @default(now())

  @@unique([monitorId, postId], name: "monitorId_postId")
  @@map("hashtag_leads")
}

// ─── Winning Patterns (AI analytics) ────────────────────

model WinningPattern {
  id            String   @id @default(cuid())
  tenantId      String
  descripcion   String
  avgEngagement Float    @default(0)
  formato       String?
  objetivo      String?
  postCount     Int      @default(0)

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("winning_patterns")
}

// ─── A/B Tests ──────────────────────────────────────────

model ABTest {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  hypothesis  String?
  postARef    String
  postBRef    String?
  status      String    @default("draft")
  winner      String?
  notes       String?
  startedAt   DateTime?
  endedAt     DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ab_tests")
}

// ─── Post Approvals ─────────────────────────────────────

model PostApproval {
  id            String   @id @default(cuid())
  tenantId      String
  postId        String   @unique
  token         String   @unique @default(cuid())
  status        String   @default("pending")
  approverEmail String?
  approverName  String?
  comment       String?
  requestedAt   DateTime @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_approvals")
}

// ─── Social Leads (CRM) ──────────────────────────────────

model SocialLead {
  id             String    @id @default(cuid())
  tenantId       String
  whatsappPhone  String
  nombre         String?
  email          String?
  tags           String[]  @default([])
  stage          String    @default("new")
  closerName     String?
  dealValue      Float?
  fuentePostId   String?
  leadScore      Int       @default(0)
  scoreReason    String?
  lastActivity   DateTime?

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  activities     LeadActivity[]
  notes          LeadNote[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, whatsappPhone])
  @@map("social_leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  tipo      String
  detalle   String?
  createdAt DateTime @default(now())

  lead      SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  body      String
  createdAt DateTime @default(now())

  lead      SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

// ─── Affiliates ──────────────────────────────────────────

model Affiliate {
  id         String   @id @default(cuid())
  tenantId   String
  code       String   @unique
  name       String
  email      String
  phone      String?
  type       String   @default("REFERRAL")
  commission Float    @default(10)
  notes      String?
  active     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  referrals  AffiliateReferral[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("affiliates")
}

model AffiliateReferral {
  id            String   @id @default(cuid())
  affiliateId   String
  amount        Float    @default(0)
  commission    Float    @default(0)
  status        ReferralStatus @default(PENDING)
  description   String?

  referredName  String?
  referredEmail String?
  referredPhone String?
  notes         String?
  paidAt        DateTime?

  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@map("affiliate_referrals")
}

enum ReferralStatus {
  PENDING
  CONVERTED
  APPROVED
  PAID
  REJECTED
}

// ─── Bio Page (Link-in-bio) ──────────────────────────────

model BioPage {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  title       String?
  description String?
  avatarUrl   String?
  theme       String   @default("dark")
  published   Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  links       BioLink[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bio_pages")
}

model BioLink {
  id         String   @id @default(cuid())
  bioPageId  String
  label      String
  url        String
  icon       String?
  utmSource  String   @default("bio")
  utmMedium  String   @default("social")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  clicks     Int      @default(0)

  bioPage    BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@map("bio_links")
}

// ─── Video Scripts ───────────────────────────────────────

model VideoScript {
  id           String   @id @default(cuid())
  tenantId     String
  template     String
  topic        String
  title        String?
  hook         String?
  script       Json?
  outputUrl    String?
  thumbnailUrl String?
  duration     Int?
  style        String?
  error        String?
  status       String   @default("draft")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("video_scripts")
}

// ─── Meta Compliance ────────────────────────────────────

model MetaDeletionLog {
  id               String   @id @default(cuid())
  confirmationCode String   @unique
  metaUserId       String
  status           String   @default("completed")
  createdAt        DateTime @default(now())

  @@map("meta_deletion_logs")
}


model TranscriptInsight {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  sourceUrl   String?
  transcript  String
  hooks       Json
  historias   Json
  frameworks  Json
  objeciones  Json
  citas       Json
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
